NODE_ENV=development
PORT=4040
MONGODB_URI=mongodb://127.0.0.1:27017/abyuday
RABBITMQ_URL=amqp://localhost:5672
GEMINI_API_KEY=replace-with-your-gemini-api-key
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
TEST_TOKEN_SECRET=replace-with-a-third-long-random-secret
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4040/auth/google/callback
# CLIENT_ORIGIN=https://your-app.example
# RUN_WORKER=false
# RUN_MAIL_WORKER=false
# Gmail setup matches the reference Abyuday project's Nodemailer transport.
# Credentials belong only in .env / your deployment's secret configuration.
EMAIL_ENABLED=false
SMTP_SERVICE=gmail
SMTP_USER=your-sender@gmail.com
SMTP_PASS=replace-with-your-gmail-app-password
SMTP_FROM="Abyuday <your-sender@gmail.com>"
# Public application origin for links in emails; use https://... in production.
APP_URL=http://localhost:4040
# Optional independent encryption secret. Defaults to a derived TEST_TOKEN_SECRET key.
# EMAIL_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Existing account with authority to grant and revoke platform admin access.
# PLATFORM_OWNER_EMAIL=owner@example.com
