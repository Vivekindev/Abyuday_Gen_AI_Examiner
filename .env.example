NODE_ENV=development
PORT=4040
MONGODB_URI=mongodb://127.0.0.1:27017/abyuday
RABBITMQ_URL=amqp://localhost:5672
GEMINI_API_KEY=replace-with-your-gemini-api-key
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
TEST_TOKEN_SECRET=replace-with-a-third-long-random-secret
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4040/auth/google/callback
# CLIENT_ORIGIN=https://your-app.example
# RUN_WORKER=false
# Existing account with authority to grant and revoke platform admin access.
# PLATFORM_OWNER_EMAIL=owner@example.com
